# Generate a NEW key: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Do not commit the generated key. Old tokens must be invalidated on deployment.
JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
# Comma-separated browser origins. Empty disables cross-origin browser access.
CORS_ORIGINS=http://localhost:8081
